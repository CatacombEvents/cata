        Based in Dublin.
      </p>
    </div>

    <div class="footer-links">
      <h4>EXPLORE</h4>
      <a href="#events">Upcoming events</a>
      <a href="#archive">Event archive</a>
      <a href="#friends">Catacombs & Friends</a>
      <a href="#magazine">Magazine</a>
    </div>

    <div class="footer-links">
      <h4>CONNECT</h4>
      <a href="#contact">Contact</a>
      <a href="#contact">Partnerships</a>
      <a href="#contact">Artist applications</a>
      <a href="#" onclick="openModal('newsletterModal');return false">Newsletter</a>
      <a href="https://instagram.com/" target="_blank" rel="noopener">Instagram ↗</a>
    </div>
