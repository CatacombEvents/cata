  <div class="footer-bottom">
    <span>© 2026 CATACOMBS. ALL RIGHTS RESERVED.</span>
    <span>INDEPENDENT BY NATURE.</span>
    <span>DUBLIN, IRELAND.</span>
  </div>
</footer>

<!-- TICKET MODAL -->
<div class="modal" id="ticketModal" role="dialog" aria-modal="true" aria-labelledby="ticketTitle">
  <div class="modal-box">
    <button class="modal-close" onclick="closeModal('ticketModal')" aria-label="Close">×</button>
    <div class="eyebrow">CATACOMBS / TICKETS</div>
    <h2 id="ticketTitle">GET YOUR TICKET.</h2>
    <p id="ticketDescription">Join us at the next gathering.</p>

    <label>Ticket type</label>
    <select id="ticketType" onchange="updateTotal()">
      <option value="15">Early Bird — €15</option>
      <option value="20">General Admission — €20</option>
      <option value="25">Final Release — €25</option>
    </select>

    <div class="quantity">
      <span>NUMBER OF TICKETS</span>
      <div>
        <button onclick="changeQuantity(-1)">−</button>
        <span id="quantity">1</span>
        <button onclick="changeQuantity(1)">+</button>
      </div>
    </div>

    <div class="ticket-total">
      <span>TOTAL</span>
      <strong id="ticketTotal">€15.00</strong>
    </div>

    <label>Your email</label>
    <input type="email" id="ticketEmail" placeholder="you@email.com">

    <button class="btn" onclick="checkout()">Continue to checkout ↗</button>
    <div class="form-message" id="ticketMessage"></div>
    <p style="font-size:10px;margin-top:15px">
      Demonstration checkout only. Connect a payment provider
      before accepting real payments.
    </p>
  </div>
</div>

<!-- NEWSLETTER MODAL -->
<div class="modal" id="newsletterModal" role="dialog" aria-modal="true">
  <div class="modal-box">
    <button class="modal-close" onclick="closeModal('newsletterModal')" aria-label="Close">×</button>
    <div class="eyebrow">STAY IN THE LOOP</div>
    <h2>GET CLOSER.</h2>
    <p>New events, artist announcements and stories from the underground.</p>

    <form onsubmit="subscribe(event)">
      <label>Your name</label>
      <input type="text" id="newsletterName" placeholder="Your name" required>

      <label>Email address</label>
      <input type="email" id="newsletterEmail" placeholder="you@email.com" required>

      <button class="btn" type="submit">Join the community ↗</button>
    </form>
    <div class="form-message" id="newsletterMessage"></div>
  </div>
</div>

<!-- CONTACT MODAL -->
<div class="modal" id="contactModal" role="dialog" aria-modal="true">
  <div class="modal-box">
    <button class="modal-close" onclick="closeModal('contactModal')" aria-label="Close">×</button>
    <div class="eyebrow">LET'S CONNECT</div>
    <h2>GET IN TOUCH.</h2>

    <form onsubmit="sendContact(event)">
      <label>Enquiry type</label>
      <select id="contactType">
        <option>Venue partnership</option>
        <option>Brand sponsorship</option>
        <option>Artist application</option>
        <option>General enquiry</option>
      </select>

      <label>Your name</label>
      <input type="text" id="contactName" required placeholder="Your name">

      <label>Email</label>
      <input type="email" id="contactEmail" required placeholder="you@email.com">

      <label>Tell us a little more</label>
      <textarea id="contactText" rows="4" required placeholder="Your message..."></textarea>

      <button class="btn" type="submit">Send enquiry ↗</button>
    </form>
    <div class="form-message" id="contactMessage"></div>
  </div>
</div>

<!-- COOKIE BANNER -->
<div class="cookie-banner" id="cookieBanner">
  <p>
    We use essential cookies to make this website work.
    Optional analytics cookies can help us understand how
    our community uses the website.
  </p>
  <button onclick="acceptCookies()">Accept & continue</button>
</div>

<script>

/* =================================
   CATACOMBS WEBSITE DATA
================================= */

const events = [
  {
    id: 1,
    title: "Below The Surface",
    date: "2026-12-12",
    category: "Electronic",
    location: "Dublin, Ireland",
    price: 15,
    image: "https://images.unsplash.com/photo-1501386761578-eac5c94b800a?w=900",
    description: "A night of electronic music, underground sounds and shared energy.",
    artists: "Resident DJs + Special Guests"
  },
  {
    id: 2,
    title: "After Hours",
    date: "2027-01-16",
    category: "Club Culture",
    location: "Dublin, Ireland",
    price: 20,
    image: "https://images.unsplash.com/photo-1492684223066-81342ee5ff30?w=900",
    description: "An exploration of new sounds and late-night culture.",
    artists: "Guest Artists + Residents"
  },
  {
    id: 3,
    title: "New Frequencies",
    date: "2027-02-20",
    category: "Experimental",
    location: "Dublin, Ireland",
    price: 18,
    image: "https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=900",
    description: "A platform for experimental music and emerging artists.",
    artists: "Emerging Artists"
  },
  {
    id: 4,
    title: "First Gathering",
    date: "2026-09-20",
    category: "Community",
    location: "Dublin, Ireland",
    price: 12,
    image: "https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?w=900",
    description: "A celebration of independent music and community.",
    artists: "Local Residents"
  }
];

let selectedEvent = null;
let ticketQuantity = 1;

/* =================================
   DATE FORMATTING
================================= */

function formatDate(date) {
  return new Date(date + "T12:00:00").toLocaleDateString("en-IE", {
    day: "2-digit",
    month: "short",
    year: "numeric"
  });
}

function isUpcoming(event) {
  const today = new Date();
  today.setHours(0,0,0,0);
  return new Date(event.date + "T00:00:00") >= today;
}

/* =================================
   RENDER FEATURED EVENTS
================================= */

function renderFeatured() {
  const container = document.getElementById("featuredEvents");

  const upcoming = events.filter(isUpcoming).slice(0,3);

  if (!upcoming.length) {
    container.innerHTML = "<p>New gatherings coming soon. Stay connected.</p>";
    return;
  }

  container.innerHTML = upcoming.map(event => `
    <article class="event-card">
      <div class="event-image">
        <img src="${event.image}" alt="${event.title}" loading="lazy">
        <div class="event-date">
          ${formatDate(event.date)}
        </div>
      </div>
      <div class="event-info">
        <div class="event-category">${event.category}</div>
        <h3>${event.title}</h3>
        <p>${event.description}</p>
        <div class="event-bottom">
          <span class="event-price">FROM €${event.price}</span>
          <button class="text-link" onclick="openTicket(${event.id})">
            Get tickets ↗
          </button>
        </div>
      </div>
    </article>
  `).join("");
}

/* =================================
   EVENT ARCHIVE + FILTERS
================================= */

function renderArchive(list = events) {
  const container = document.getElementById("archiveList");

  if (!list.length) {
    container.innerHTML = "<p style='padding:25px 0'>No events found.</p>";
    return;
  }

  container.innerHTML = list.map(event => `
    <div class="archive-row">
      <span class="date">${formatDate(event.date)}</span>
      <h3>${event.title}</h3>
      <span class="type">${event.category}</span>
      <button onclick="openTicket(${event.id})">
        ${isUpcoming(event) ? "Tickets ↗" : "View event ↗"}
      </button>
    </div>
  `).join("");
}

function filterEvents() {
  const search = document.getElementById("eventSearch").value.toLowerCase();
  const filter = document.getElementById("eventFilter").value;

  const filtered = events.filter(event => {
    const matchesSearch =
      event.title.toLowerCase().includes(search) ||
      event.category.toLowerCase().includes(search);

    const matchesFilter =
      filter === "all" ||
      (filter === "upcoming" && isUpcoming(event)) ||
      (filter === "past" && !isUpcoming(event));

    return matchesSearch && matchesFilter;
  });

  renderArchive(filtered);
}

/* =================================
   TICKET SYSTEM
================================= */

function openTicket(id) {
  const event = events.find(e => e.id === id);

  if (!event || !isUpcoming(event)) {
    alert("This event has already taken place. Explore the archive for more.");
    return;
  }

  selectedEvent = event;
  ticketQuantity = 1;

  document.getElementById("ticketTitle").textContent = event.title;
  document.getElementById("ticketDescription").textContent =
    `${formatDate(event.date)} · ${event.location} · ${event.artists}`;

  document.getElementById("ticketType").value = event.price;
  document.getElementById("ticketEmail").value = "";
  document.getElementById("ticketMessage").textContent = "";
  document.getElementById("quantity").textContent = "1";

  updateTotal();
  openModal("ticketModal");
}

function changeQuantity(change) {
  ticketQuantity = Math.max(1, Math.min(10, ticketQuantity + change));
  document.getElementById("quantity").textContent = ticketQuantity;
  updateTotal();
}

function updateTotal() {
  const price = Number(document.getElementById("ticketType").value);
  const total = price * ticketQuantity;

  document.getElementById("ticketTotal").textContent =
    "€" + total.toFixed(2);
}

function checkout() {
  const email = document.getElementById("ticketEmail").value;

  if (!email || !email.includes("@")) {
    document.getElementById("ticketMessage").textContent =
      "Please enter a valid email address.";
    return;
  }

  const price = Number(document.getElementById("ticketType").value);
  const total = price * ticketQuantity;

  document.getElementById("ticketMessage").textContent =
    "Demo only: connect Stripe or another ticketing provider to complete payment. Total: €" +
    total.toFixed(2);

  console.log({
    event: selectedEvent,
    email,
    quantity: ticketQuantity,
    total
  });
}

/* =================================
   MODALS
================================= */

function openModal(id) {
  document.getElementById(id).classList.add("active");
  document.body.style.overflow = "hidden";
}

function closeModal(id) {
  document.getElementById(id).classList.remove("active");

  if (!document.querySelector(".modal.active")) {
    document.body.style.overflow = "";
  }
}

document.querySelectorAll(".modal").forEach(modal => {
  modal.addEventListener("click", e => {
    if (e.target === modal) {
      closeModal(modal.id);
    }
  });
});

document.addEventListener("keydown", e => {
  if (e.key === "Escape") {
    document.querySelectorAll(".modal.active").forEach(modal => {
      closeModal(modal.id);
    });
  }
});

/* =================================
   MOBILE NAVIGATION
================================= */

function toggleMenu() {
  document.getElementById("navLinks").classList.toggle("open");
}

function closeMenu() {
  document.getElementById("navLinks").classList.remove("open");
}

/* =================================
   NEWSLETTER
================================= */

function subscribe(e) {
  e.preventDefault();

  const name = document.getElementById("newsletterName").value;
  const email = document.getElementById("newsletterEmail").value;

  // CONNECT TO MAILCHIMP / BREVO / OTHER PROVIDER HERE

  console.log({name, email});

  document.getElementById("newsletterMessage").textContent =
    "Thank you for joining CATACOMBS. Connect a newsletter service to save subscriptions.";

  e.target.reset();
}

/* =================================
   CONTACT / APPLICATION FORMS
================================= */

function openContact(type) {
  document.getElementById("contactType").value = type;
  document.getElementById("contactMessage").textContent = "";
  openModal("contactModal");
}

function sendContact(e) {
  e.preventDefault();

  const data = {
    type: document.getElementById("contactType").value,
    name: document.getElementById("contactName").value,
    email: document.getElementById("contactEmail").value,
    message: document.getElementById("contactText").value
  };

  // CONNECT TO EMAIL / FORM BACKEND HERE

  console.log(data);

  document.getElementById("contactMessage").textContent =
    "Thank you. Connect a form backend to deliver this enquiry.";

  e.target.reset();
}

/* =================================
   COOKIE CONSENT
================================= */

function acceptCookies() {
  localStorage.setItem("catacombs-cookie-choice", "accepted");
  document.getElementById("cookieBanner").style.display = "none";
}

if (!localStorage.getItem("catacombs-cookie-choice")) {
  document.getElementById("cookieBanner").style.display = "flex";
}

/* =================================
   INITIALISE
================================= */

renderFeatured();
renderArchive();

</script>
</body>
</html>
